{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "sourceMap": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
