# Copy to .env for local development. Never commit .env or use VITE_* for secrets.
# Create a strong hash with: npm run admin:hash
# ADMIN_PASSWORD_HASH=scrypt$...
# Local development ONLY (minimum 12 characters). Rejected when NODE_ENV=production.
# ADMIN_PASSWORD=

NODE_ENV=development
PORT=3000
DATA_DIR=.data
VISITOR_LOG_ENABLED=true
VISITOR_LOG_RETENTION_DAYS=30
# Bound storage; new logging pauses at this limit rather than evicting records.
VISITOR_LOG_MAX_ROWS=50000

# Server-side IP-to-city lookup. Disabling it does not disable IP/device logging.
GEOIP_ENABLED=true
# Optional server-only ipinfo token; recommended for a reliable quota.
# IPINFO_TOKEN=

# Required in production: real site origin and a monitored privacy contact.
# PUBLIC_ORIGIN=https://your-domain.example
# PRIVACY_CONTROLLER=Your real company or owner name
# PRIVACY_CONTACT=privacy@your-domain.example

# Default 0: ignore X-Forwarded-For. Only change after verifying that your own
# trusted reverse proxy replaces (not blindly appends) untrusted forwarding headers.
TRUST_PROXY_HOPS=0

# Fictional dashboard rows + temporary in-memory database. Never allowed in production.
DEMO_MODE=false
